{
  "name": "lazy-tab-purger",
  "version": "1.0.0",
  "description": "Obsidian plugin: auto-close inactive background tabs",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^5.2.0",
    "esbuild": "0.17.3",
    "minimatch": "^10.2.5",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
